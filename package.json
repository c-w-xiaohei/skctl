{
  "name": "skill-cli-workspace",
  "private": true,
  "workspaces": [
    "packages/skill-cli",
    "packages/opencode-adapter"
  ],
  "scripts": {
    "format:check": "oxfmt --check",
    "typecheck": "bunx tsc -p packages/skill-cli/tsconfig.json --noEmit && bunx tsc -p packages/opencode-adapter/tsconfig.json --noEmit",
    "lint": "oxlint --deny-warnings",
    "schema:write": "bun scripts/schema.ts write",
    "schema:check": "bun scripts/schema.ts check",
    "precommit": "bun run format:check && bun run typecheck && bun run lint",
    "prepare": "husky",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run schema:check && bun test packages/skill-cli/test/unit/config-schema.test.ts",
    "test:unit": "bun test packages/skill-cli/test/unit",
    "test:providers": "bun test packages/skill-cli/test/provider",
    "test:integration": "bun test packages/skill-cli/test/integration",
    "test:interfaces": "bun test packages/skill-cli/test/cli packages/skill-cli/test/tui packages/opencode-adapter/test",
    "test:packaged": "bun test verification/packaged",
    "smoke:packaged": "bun verification/packaged/smoke.ts",
    "build:native": "bun scripts/build.ts native",
    "pack:plugin": "bun scripts/build.ts plugin"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.18.4",
    "@types/bun": "1.3.14",
    "husky": "9.1.7",
    "opencode-ai": "1.18.4",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2"
  }
}
