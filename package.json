{
  "name": "skctl-workspace",
  "private": true,
  "workspaces": [
    "packages/skill-core",
    "packages/skctl",
    "packages/sktui",
    "packages/opencode-adapter"
  ],
  "scripts": {
    "format:check": "oxfmt --check",
    "typecheck": "./scripts/resource-run.sh sh -c 'bun node_modules/typescript/bin/tsc -p packages/skill-core/tsconfig.json --noEmit && bun node_modules/typescript/bin/tsc -p packages/skctl/tsconfig.json --noEmit && bun node_modules/typescript/bin/tsc -p packages/sktui/tsconfig.json --noEmit && bun node_modules/typescript/bin/tsc -p packages/opencode-adapter/tsconfig.json --noEmit'",
    "lint": "oxlint --deny-warnings",
    "schema:write": "bun scripts/schema.ts write",
    "schema:check": "bun scripts/schema.ts check",
    "precommit": "bun run format:check && bun run typecheck && bun run lint",
    "prepare": "husky",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run schema:check && bun test packages/skill-core/test/unit/config-schema.test.ts",
    "test:unit": "bun test packages/skill-core/test/unit",
    "test:providers": "bun test packages/skill-core/test/provider",
    "test:integration": "bun test packages/skill-core/test/integration",
    "test:cli": "bun test packages/skctl/test",
    "test:tui": "./scripts/resource-run.sh bun test --max-concurrency=1 --preload @opentui/solid/preload --preload ./packages/sktui/test/test-renderer-preload.ts packages/sktui/test",
    "dev:tui": "bun --preload @opentui/solid/preload packages/sktui/src/main.ts",
    "test:interfaces": "bun run test:cli && bun run test:tui && bun test packages/opencode-adapter/test",
    "test:packaged": "bun test verification/packaged",
    "smoke:packaged": "bun verification/packaged/smoke.ts",
    "build:cli": "./scripts/resource-run.sh bun scripts/build.ts cli",
    "build:tui": "./scripts/resource-run.sh bun scripts/build.ts tui",
    "build:native": "./scripts/resource-run.sh bun scripts/build.ts native",
    "pack:plugin": "./scripts/resource-run.sh bun scripts/build.ts plugin"
  },
  "devDependencies": {
    "@opencode-ai/sdk": "1.18.4",
    "@types/bun": "1.4.3",
    "@valibot/to-json-schema": "1.8.0",
    "husky": "9.1.7",
    "opencode-ai": "1.18.4",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@opentui/core": "0.5.14",
    "@opentui/solid": "0.5.14"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
